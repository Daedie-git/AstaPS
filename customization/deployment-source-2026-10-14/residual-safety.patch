+                switch (entry.getKey()) {
+                    case "Actor_HpThresholdRatio" -> result.Actor_HpThresholdRatio = value;
+                    case "Actor_MaxHPRatio" -> result.Actor_MaxHPRatio = value;
+                    case "Actor_CostStaminaRatio" -> result.Actor_CostStaminaRatio = value;
